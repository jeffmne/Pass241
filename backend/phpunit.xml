<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            Les tests tournent sur PostgreSQL, pas sur SQLite en memoire.
            L'integrite financiere du projet (contraintes CHECK, index uniques
            partiels, verrous de ligne pour les holds de stock) depend de
            comportements propres a PostgreSQL : un test vert sur SQLite ne
            prouverait rien sur l'environnement reel.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="postgres"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="pass241_testing"/>
        <env name="DB_USERNAME" value="pass241"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_URL" value=""/>

        <!--
            Vues compilees dans un dossier a part.

            La suite tourne en root depuis `docker compose exec`, les workers
            PHP-FPM en www-data. Partager le meme dossier fait qu'une vue
            compilee par les tests appartient a root : le worker peut ensuite
            l'ecrire, mais pas fixer sa date de modification — `touch()` sur un
            fichier qu'on ne possede pas est refuse par le noyau. La page tombe
            alors en « Utime failed: Operation not permitted », et seulement
            APRES avoir lance les tests, ce qui rend le lien difficile a voir.
        -->
        <env name="VIEW_COMPILED_PATH" value="storage/framework/testing/views"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PAYMENT_DEFAULT_DRIVER" value="fake"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
