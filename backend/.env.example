APP_NAME=Pass241
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Marche gabonais : interface en francais, fuseau de Libreville
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Les dates sont stockees en UTC (config/app.php). Ce fuseau ne sert qu'a
# l'affichage : heure d'un evenement, horodatage d'un scan, date d'un recu.
APP_DISPLAY_TIMEZONE=Africa/Libreville

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de donnees (section 60) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pass241
DB_USERNAME=pass241
DB_PASSWORD=secret

# --- Redis : cache, sessions, queues, holds de stock (section 17.1) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
HORIZON_PREFIX=pass241_horizon

# --- Temps reel (section 60.2) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=pass241
REVERB_APP_KEY=pass241key
REVERB_APP_SECRET=pass241secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- API app agents (section 60.4) ---
SANCTUM_STATEFUL_DOMAINS=localhost:8000

FILESYSTEM_DISK=local

# --- Email : Mailpit en local, http://localhost:8025 ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@pass241.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Paiements (section 21) ---
# fake  : provider de developpement (push USSD simule, webhook, timeout, echec)
# airtel / moov : providers reels, actives quand les credentials seront obtenus
PAYMENT_DEFAULT_DRIVER=fake

AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=

MOOV_CLIENT_ID=
MOOV_CLIENT_SECRET=
MOOV_BASE_URL=

# --- Billetterie (section 18) ---
# Cle de signature des tokens QR. Distincte de APP_KEY : une rotation de
# APP_KEY ne doit jamais invalider les billets deja vendus.
TICKET_TOKEN_SIGNING_KEY=

# --- Notifications (section 69) ---
# Le canal SMS n'est pas active au lancement, le fournisseur reste a definir.
EMAIL_API_KEY=
SMS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
